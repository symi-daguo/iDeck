# Generated/retained upstream license texts preserve their original whitespace.
app/Frameworks/StikJIT.xcframework/** -whitespace
app/Madeira/legal/LICENSES-*.txt -whitespace
LICENSES/stikjit-supplemental/** -whitespace

# Unified patches retain the required context prefix on empty lines.
build/wine-pe/steam-ui-machine-attributes.patch -whitespace

# Shell and Python helpers must keep LF so they run on macOS unchanged.
*.sh text eol=lf
*.py text eol=lf
